{
  "description": "Agent Info development integration. Review before enabling.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jiangxinyi/Documents/Project/agent-info/build/macos-adaptation/issue49-codex-preparation-1/稳定 中文 '\"'\"'quote $literal; bundle/info-codex-hook'",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jiangxinyi/Documents/Project/agent-info/build/macos-adaptation/issue49-codex-preparation-1/稳定 中文 '\"'\"'quote $literal; bundle/info-codex-hook'",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jiangxinyi/Documents/Project/agent-info/build/macos-adaptation/issue49-codex-preparation-1/稳定 中文 '\"'\"'quote $literal; bundle/info-codex-hook'",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
