{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-info-manage:request-use:1",
  "title": "Credential use request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "purpose", "credentials", "launch"],
  "properties": {
    "command": {"const": "request-use"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
    "credentials": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["alias", "credentialId", "version"],
        "properties": {
          "alias": {"$ref": "#/$defs/alias"},
          "credentialId": {"$ref": "#/$defs/id"},
          "version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        }
      }
    },
    "launch": {
      "type": "object", "additionalProperties": false,
      "required": ["receiver", "executable", "argv", "cwd", "env"],
      "properties": {
        "receiver": {"enum": ["gh_token", "ssh_identity", "aws_shared_credentials"]},
        "executable": {"$ref": "#/$defs/path"},
        "cwd": {"$ref": "#/$defs/path"},
        "argv": {
          "type": "array", "maxItems": 128,
          "items": {"oneOf": [{"$ref": "#/$defs/literal"}, {"$ref": "#/$defs/file"}]}
        },
        "env": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/alias"},
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/literal"}, {"$ref": "#/$defs/file"}, {"$ref": "#/$defs/secret"}]}
        }
      }
    },
    "readFields": {
      "type": "array", "maxItems": 200, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["itemId", "fieldId"],
        "properties": {"itemId": {"$ref": "#/$defs/id"}, "fieldId": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]+$"},
    "alias": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
    "literal": {"type": "string", "maxLength": 8192, "pattern": "^[^\\u0000]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:[A-Za-z]:[\\\\/]|/)[^\\u0000]*$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["file"], "properties": {"file": {"$ref": "#/$defs/alias"}}},
    "secret": {"type": "object", "additionalProperties": false, "required": ["secret"], "properties": {"secret": {"$ref": "#/$defs/alias"}}}
  },
  "$comment": "Application validation additionally enforces UTF-8 byte limit, no duplicate JSON keys, case-folded env uniqueness, credential form/version/visibility, full alias use, absolute canonical local path checks and receiver-specific fixed effective argv. This schema does not replace those checks."
}
